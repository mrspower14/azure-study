## webshk 
#2. web 앱 구성
#2.1 [설정] 섹션의 [환경변수]-[앱 설정] 링크

#2.2 [애플리케이션 설정 추가/편집]
#이름: ApiUrl
#값: api 앱의 URL (https://apishk.azurewebsites.net)
  # 적용 -> 적용 -> 확인

#3. api 앱 코드 배포
az login

#az webapp deployment source config-zip --resource-group rg-paaslab --src api.zip --name api[SUFFIX]
az webapp deployment source config-zip --resource-group rg-paaslab-shk --src api.zip --name apishk

#4. api 앱 동작 테스트

#5. web 앱 코드 배포
#az webapp deployment source config-zip --resource-group rg-paaslab --src web.zip --name web[SUFFIX]
az webapp deployment source config-zip --resource-group rg-paaslab-shk --src web.zip --name webshk

#6. web 앱 동작 테스트
